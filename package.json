{
  "name": "dataportal-blocks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "blocks-bundler",
    "dev": "blocks-bundler --watch",
    "serve": "browser-sync start --server . --startPath /demo/ --files \"dist/*.js\" --no-notify --port 5173",
    "start": "concurrently --names dev,serve --prefix-colors blue,green \"npm run dev\" \"npm run serve\"",
    "format": "prettier --write \"src/**/*.{js,css}\" \"demo/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"demo/**/*.{js,css,html}\""
  },
  "devDependencies": {
    "@entryscape/blocks-bundler": "^0.2.0",
    "browser-sync": "^3.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
